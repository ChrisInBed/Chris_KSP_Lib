# Local editor and development settings
.vscode/
**/.vs/
.local/
/dist/
*.user
*.suo
*.userosscache
*.sln.docstates

# C# build outputs, installed plugins and restored dependencies
**/bin/
**/obj/
**/GameData/
**/packages/
**/Resources/
